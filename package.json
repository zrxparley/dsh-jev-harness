{
  "name": "@zrxparley/dsh-jev-harness",
  "version": "1.6.0",
  "description": "Tiered LLM harness for DeepSeek Harness: one switch, JEV decides every task, then Kimi K3.1 Pro handles judgment and DeepSeek 4.1 Flash handles execution, via OpenAI-compatible gateways.",
  "type": "module",
  "license": "MIT",
  "author": "zrxparley",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zrxparley/dsh-jev-harness.git"
  },
  "homepage": "https://github.com/zrxparley/dsh-jev-harness#readme",
  "bugs": {
    "url": "https://github.com/zrxparley/dsh-jev-harness/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "model-router",
    "tiered-harness",
    "kimi",
    "deepseek",
    "quality-gate"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "skills.js",
    "lib/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-renderer"
      ],
      "platform": "web"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
